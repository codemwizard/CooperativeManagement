# Copy to .env.local for local development. Never commit local environment files.
DATABASE_URL=postgresql://symphony:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/symphony
MIGRATION_TEST_DATABASE_URL=postgresql://symphony:REPLACE_WITH_TEST_PASSWORD@localhost:5433/symphony_migrations_test
DATABASE_SCHEMA=symphony
DATA_MODE=test
NODE_ENV=development
SYMPHONY_ROOT_KEY_HEX=REPLACE_WITH_64_HEX_CHARACTERS
SYMPHONY_BLIND_PEPPER=REPLACE_WITH_RANDOM_SECRET
