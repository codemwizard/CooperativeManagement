{
  "version": "1.0",
  "note": "Help text for tooltips, popovers and helper text. Text may use {{meta.*}}, {{destinations.<id>.*}} and {{interventions.*}} tokens resolved from the data files, with optional |num filter, and {{value.<name>}} tokens supplied by the component and declared in value_tokens. See UI_HELP_SPEC_V1.md.",
  "limits": {
    "tooltip_max_words": 30,
    "popover_max_words": 60,
    "helper_max_words": 25,
    "tour_max_words": 45
  },
  "banned_words": [
    "approved",
    "bankable",
    "creditworthy",
    "score",
    "rating",
    "guaranteed",
    "immutable",
    "impossible"
  ],
  "entries": [
    {
      "id": "state.none",
      "pattern": "tooltip",
      "screens": [
        "sme_dashboard",
        "org_state",
        "project_state",
        "requirements",
        "gap_remediation",
        "readiness_basis",
        "destination_projection",
        "lender_assessment"
      ],
      "text": "No evidence is on record for this item."
    },
    {
      "id": "state.asserted",
      "pattern": "tooltip",
      "screens": [
        "sme_dashboard",
        "org_state",
        "project_state",
        "requirements",
        "gap_remediation",
        "readiness_basis",
        "destination_projection",
        "lender_assessment"
      ],
      "text": "Stated by the cooperative, with no record attached."
    },
    {
      "id": "state.supported",
      "pattern": "tooltip",
      "screens": [
        "sme_dashboard",
        "org_state",
        "project_state",
        "requirements",
        "gap_remediation",
        "readiness_basis",
        "destination_projection",
        "lender_assessment"
      ],
      "text": "A record is attached. It has not been independently checked."
    },
    {
      "id": "state.verified",
      "pattern": "tooltip",
      "screens": [
        "sme_dashboard",
        "org_state",
        "project_state",
        "requirements",
        "gap_remediation",
        "readiness_basis",
        "destination_projection",
        "lender_assessment"
      ],
      "text": "Checked independently by an authorised field agent. The limitation line says what the check did not cover."
    },
    {
      "id": "state.disputed",
      "pattern": "tooltip",
      "screens": [
        "sme_dashboard",
        "org_state",
        "project_state",
        "requirements",
        "gap_remediation",
        "readiness_basis",
        "destination_projection",
        "lender_assessment"
      ],
      "text": "Someone has recorded an objection. The requirement stays in exception until an independent field agent re-verifies the evidence or the objection is withdrawn."
    },
    {
      "id": "state.stale",
      "pattern": "tooltip",
      "screens": [
        "sme_dashboard",
        "org_state",
        "project_state",
        "requirements",
        "gap_remediation",
        "readiness_basis",
        "destination_projection",
        "lender_assessment"
      ],
      "text": "The evidence is past its validity date and must be renewed."
    },
    {
      "id": "req.satisfied",
      "pattern": "tooltip",
      "screens": [
        "requirements",
        "readiness_basis",
        "lender_assessment"
      ],
      "text": "The evidence meets the level this destination asks for."
    },
    {
      "id": "req.unresolved",
      "pattern": "tooltip",
      "screens": [
        "requirements",
        "readiness_basis",
        "lender_assessment"
      ],
      "text": "Applicable, but the evidence is missing or below the level required."
    },
    {
      "id": "req.exception",
      "pattern": "tooltip",
      "screens": [
        "requirements",
        "readiness_basis",
        "lender_assessment"
      ],
      "text": "This was on record, but the evidence is now stale or disputed."
    },
    {
      "id": "req.not_applicable",
      "pattern": "tooltip",
      "screens": [
        "requirements",
        "readiness_basis",
        "lender_assessment"
      ],
      "text": "This requirement does not apply to this project. The reason is shown on the card."
    },
    {
      "id": "req.assessment_time",
      "pattern": "popover",
      "screens": [
        "requirements",
        "readiness_basis",
        "lender_assessment"
      ],
      "text": "The lender decides this at assessment, for example an off-take arrangement. It does not block readiness. Evidence may be added early and is then shown as provided early."
    },
    {
      "id": "chain.requirement",
      "pattern": "tooltip",
      "screens": [
        "readiness_basis"
      ],
      "text": "What the destination asks for, and where the requirement comes from."
    },
    {
      "id": "chain.applicability",
      "pattern": "tooltip",
      "screens": [
        "readiness_basis"
      ],
      "text": "Whether the requirement applies to this project, and why."
    },
    {
      "id": "chain.evidence",
      "pattern": "tooltip",
      "screens": [
        "readiness_basis"
      ],
      "text": "The records that support the requirement, with who supplied them and when."
    },
    {
      "id": "chain.verification",
      "pattern": "tooltip",
      "screens": [
        "readiness_basis"
      ],
      "text": "Who independently checked the evidence, and when."
    },
    {
      "id": "chain.finding",
      "pattern": "tooltip",
      "screens": [
        "readiness_basis"
      ],
      "text": "The result of comparing the evidence with the requirement."
    },
    {
      "id": "chain.state",
      "pattern": "tooltip",
      "screens": [
        "readiness_basis"
      ],
      "text": "The resulting state. It is computed from the evidence and never typed in."
    },
    {
      "id": "rule.min_level",
      "pattern": "tooltip",
      "screens": [
        "requirements",
        "readiness_basis"
      ],
      "text": "The lowest evidence level this destination accepts for this requirement."
    },
    {
      "id": "rule.evidence_count",
      "pattern": "tooltip",
      "screens": [
        "requirements",
        "readiness_basis"
      ],
      "text": "Needs a minimum count, such as seasons of farming, as well as a minimum evidence level."
    },
    {
      "id": "rule.provided_early",
      "pattern": "tooltip",
      "screens": [
        "requirements",
        "lender_assessment"
      ],
      "text": "Evidence was added before the lender's assessment. It is shown but does not change readiness."
    },
    {
      "id": "rule.fit",
      "pattern": "popover",
      "screens": [
        "requirements",
        "gap_remediation",
        "destination_projection"
      ],
      "text": "A fit check compares the request with the lender's product range. It cannot be closed with evidence. It closes only by restructuring the request, which can change another lender's fit check."
    },
    {
      "id": "readiness.ready",
      "pattern": "popover",
      "screens": [
        "sme_dashboard",
        "readiness_basis",
        "destination_projection"
      ],
      "text": "Every applicable requirement for this destination is met, or is decided by the lender at assessment. The lender still performs its own assessment and makes its own decision.",
      "see_more": {
        "label": "See the full basis",
        "target_screen": "readiness_basis"
      }
    },
    {
      "id": "readiness.not_ready",
      "pattern": "popover",
      "screens": [
        "sme_dashboard",
        "readiness_basis",
        "destination_projection"
      ],
      "text": "Some applicable requirements are unresolved or in exception. Open the basis to see which, who owns each, and what evidence is needed.",
      "see_more": {
        "label": "See the full basis",
        "target_screen": "readiness_basis"
      }
    },
    {
      "id": "readiness.preview",
      "pattern": "popover",
      "screens": [
        "sme_dashboard",
        "destination_projection"
      ],
      "text": "{{value.unresolved_count}} unresolved and {{value.exception_count}} in exception for {{value.destination}}.",
      "see_more": {
        "label": "See the full basis",
        "target_screen": "readiness_basis"
      },
      "value_tokens": [
        "unresolved_count",
        "exception_count",
        "destination"
      ]
    },
    {
      "id": "step.upload_minutes",
      "pattern": "popover",
      "screens": [
        "gap_remediation"
      ],
      "text": "The secretary uploads the minutes of the meeting. They record who holds office and what was resolved. The evidence is then Supported."
    },
    {
      "id": "step.signoff_minutes",
      "pattern": "popover",
      "screens": [
        "gap_remediation"
      ],
      "text": "The chairman signs off the minutes. Sign-off is required before a field agent can verify governance."
    },
    {
      "id": "step.field_verification",
      "pattern": "popover",
      "screens": [
        "gap_remediation"
      ],
      "text": "An authorised field agent, who did not supply the evidence, checks it. The check is recorded together with a limitation."
    },
    {
      "id": "step.add_evidence",
      "pattern": "popover",
      "screens": [
        "gap_remediation"
      ],
      "text": "A cooperative officer adds a record. It supersedes the earlier one, and the earlier record stays in the history."
    },
    {
      "id": "step.restructure_request",
      "pattern": "popover",
      "screens": [
        "gap_remediation",
        "destination_projection"
      ],
      "text": "Changes how the request is structured, for example from one facility to per-group requests. Evidence is not changed, but different lenders' fit checks can change."
    },
    {
      "id": "step.present",
      "pattern": "popover",
      "screens": [
        "gap_remediation",
        "destination_projection",
        "present_modal"
      ],
      "text": "The chairman presents the readiness record to a destination. It is frozen as a snapshot, and the destination then does its own assessment."
    },
    {
