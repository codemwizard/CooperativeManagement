  "constraints": [
    {
      "code": "PROMOTE_NO_QUALIFYING_FINDING",
      "rule": "Promotion requires a verified_conformant or verified_with_qualifications finding on this evidence and version."
    },
    {
      "code": "PROMOTE_VERSION_MISMATCH",
      "rule": "The cited finding references a different evidence version than the current one and cannot promote it."
    },
    {
      "code": "PROMOTE_CONFLICTING_FINDING",
      "rule": "A conflicting non-conformant or inconclusive finding exists on this version. Resolve the conflict before promoting."
    },
    {
      "code": "SELF_VERIFICATION",
      "rule": "mark_verified is blocked when actor.user_id equals evidence.supplied_by."
    },
    {
      "code": "SELF_CONFIRMATION",
      "rule": "confirm_payment is blocked when actor.user_id equals payment.recorded_by."
    },
    {
      "code": "ROLE_NOT_PERMITTED",
      "rule": "Any action by a role not listed for that action is blocked."
    },
    {
      "code": "SIGNOFF_REQUIRED",
      "rule": "mark_verified on governance evidence requires a prior signoff_minutes event."
    },
    {
      "code": "READ_ONLY_ROLE",
      "rule": "Lender, TA, fund manager and verifier roles cannot modify evidence items. Disputes, assignments, findings, reliance and requests are separate records."
    },
    {
      "code": "DISPUTE_REASON_REQUIRED",
      "rule": "A dispute needs a reason code and a note of 1 to 200 characters."
    },
    {
      "code": "NO_SUCH_EVIDENCE",
      "rule": "The evidence type is not on record for this case."
    },
    {
      "code": "DISPUTE_ALREADY_OPEN",
      "rule": "One open dispute is allowed per evidence type."
    },
    {
      "code": "SELF_DISPUTE",
      "rule": "A user cannot dispute evidence they supplied."
    },
    {
      "code": "NO_OPEN_DISPUTE",
      "rule": "There is no open dispute for this evidence."
    },
    {
      "code": "NOT_DISPUTE_RAISER",
      "rule": "Only the user who raised a dispute can withdraw it."
    },
    {
      "code": "SAME_VERIFIER",
      "rule": "Re-verification must be by a field agent other than the previous verifier."
    },
    {
      "code": "NO_SUCH_TARGET",
      "rule": "The claim or evidence to verify does not exist for this case."
    },
    {
      "code": "NO_SUCH_VERIFIER",
      "rule": "The assignee must be a verifier user."
    },
    {
      "code": "NOT_ASSIGNEE",
      "rule": "Only the assigned verifier can record a finding for the assignment."
    },
    {
      "code": "ASSIGNMENT_COMPLETED",
      "rule": "A finding has already been recorded for this assignment."
    },
    {
      "code": "FINDING_FIELDS_REQUIRED",
      "rule": "A finding needs a result, a scope and a limitation."
    },
    {
      "code": "NO_FINDING",
      "rule": "Reliance can only be recorded on an existing finding."
    },
    {
      "code": "RELIANCE_ALREADY_RECORDED",
      "rule": "This user has already recorded reliance on this finding."
    },
    {
      "code": "ACCESS_DENIED_COHORT",
      "rule": "This case is outside the user's assigned cohorts."
    },
    {
      "code": "OUTCOME_REQUIRED",
      "rule": "Outcome must be explicitly selected before it is recorded."
    },
    {
      "code": "REQUEST_FIELDS_REQUIRED",
      "rule": "Evidence request needs a requirement and note."
    },
    {
      "code": "PRESENTATION_REQUIRED",
      "rule": "Lender records require a presented or financed case."
    },
    {
      "code": "INVALID_ADMISSION",
      "rule": "Admission must be accepted, requires_independent_query, or rejected."
    }
  ],
  "user_id_convention": "c{N}.{role} for cooperative officers (e.g. c1.secretary); fa.banda and fa.mulenga for field agents; pfi.credit1; ta.officer1; vvb.reviewer1",
