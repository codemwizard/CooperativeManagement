{
  "name": "@symphony/workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React workspace app — uses contracts and domain read-only presenters only",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:unit": "vitest run --reporter=verbose",
    "test:a11y": "playwright test tests/workspace/a11y.spec.ts"
  },
  "dependencies": {
    "@symphony/contracts": "*",
    "@symphony/domain": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.48.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^25.0.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.2",
    "vitest": "^2.1.1"
  }
}

