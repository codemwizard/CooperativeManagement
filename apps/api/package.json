{
  "name": "@symphony/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify API: auth, command endpoint, projections, outbox worker",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./serialisers/masking-serialiser": "./src/serialisers/masking-serialiser.ts"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env.local --env-file-if-exists=../../.env --import tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test:api": "vitest run --reporter=verbose"
  },
  "dependencies": {
    "@symphony/domain": "*",
    "@symphony/db": "*",
    "@symphony/contracts": "*",
    "fastify": "^5.1.0",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "vitest": "^2.1.1"
  }
}

