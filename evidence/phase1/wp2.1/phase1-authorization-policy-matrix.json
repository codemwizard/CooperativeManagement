      "source_refs": ["D-17", "ADR-020", "O-6", "REQ-AUD-008"]
    }
  ],
  "precedence": [
    "Malformed action, target, actor, timestamp, or authority evidence denies.",
    "Unknown action or parameter values deny.",
    "Institutional read-only role denies before action-specific authority is considered.",
    "Tenant and resource scope must match before appointment, capacity, delegation, or role rules can allow.",
    "Only then apply the action's explicit authority rule; governance advisory/warning modes cannot override an authorization denial."
  ],
  "temporal_semantics": {
    "active_interval": "activeFrom <= now < activeTo",
    "grant_interval": "activeFrom < activeTo and activeTo > now",
    "equality_at_expiry": "denied",
    "revocation": "A revoked authority is represented by its effective end time; at the end-time equality the authority is inactive."
  },
  "required_boundary_dimensions": [
    "unknown_action_denies",
    "malformed_or_unknown_parameter_denies",
    "missing_or_contradictory_authority_denies",
    "tenant_mismatch_denies",
    "same_tenant_wrong_organization_denies",
    "wrong_or_missing_cohort_scope_denies",
    "authority_before_active_from_denies",
    "authority_at_active_from_allows_when_other_conditions_pass",
    "authority_before_active_to_allows_when_other_conditions_pass",
    "authority_at_active_to_denies",
    "revoked_authority_denies_after_effective_time",
    "institutional_read_only_precedence_denies",
    "invalid_grant_interval_denies",
    "assisted_enroller_requires_active_session_presence_and_recorded_decision"
  ],
  "phase2_exclusions": [
    { "id": "RecordFinding", "reason": "IFV finding workflow and person-based conflicts remain original Phase 2 Feature 05." },
    { "id": "IFV self-verification conflict", "reason": "Person/account linkage is not a Phase 1 authority dependency." },
    { "id": "historical finding annotation", "reason": "Revocation preserves historical findings; no Phase 2 annotation workflow is added." }
  ]
